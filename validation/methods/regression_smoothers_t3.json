    {
      "id": "loess_direct",
      "name": "LOESS with exact local fits (R loess surface = 'direct')",
      "category": "regression",
      "reference": "stats::loess(control = loess.control(surface = 'direct')); stats::lowess's rule at zero-width neighbourhoods",
      "doc": "validation/regression/loess.md",
      "cases": [
        "loess_x10_direct",
        "loess_skewed_direct",
        "smoothers_gcv_periodic_loess"
      ],
      "tests": [
        "p2a-core::regression::loess::tests::test_validate_loess_x10_direct",
        "p2a-core::regression::loess::tests::test_validate_loess_skewed_direct",
        "p2a-core::regression::loess::tests::test_validate_loess_mass_point",
        "p2a-core::regression::loess::tests::test_validate_loess_scale_invariance"
      ],
      "quantities": [
        "fitted values, degrees 0-2, span < 1, = 1, > 1",
        "predictions",
        "trace of the hat matrix (p2a enp)",
        "fit at zero-width neighbourhoods",
        "scale invariance in x"
      ],
      "tolerance": "validation/README.md coefficient row (n = 10: 1e-6, n = 100: 1e-8); trace as statistics",
      "deviations": [
        {
          "finding": "REG-60",
          "quantity": "R's enp (one.delta + 2 trace.hat - n), residual SE (one.delta), robust iterations",
          "note": "p2a's enp is tr(L) = R trace.hat; enp_r_s075_d2 4.950126136174497 is not compared"
        }
      ],
      "supersedes_legacy": []
    },
    {
