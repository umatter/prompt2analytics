      "deviations": [{"finding": "STAT-27", "quantity": "exact p-values (one- and two-sample); two-sided two-sample asymptotic p", "note": "p2a has no exact distribution and applies Stephens' factor; R values in *_p_exact and two*_p_asym"}, {"finding": "STAT-26", "quantity": "degenerate reference distribution", "note": "p2a refuses; ks.test evaluates a point mass (sd = 0) or warns and returns NaN"}],
      "supersedes_legacy": []
