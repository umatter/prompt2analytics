      "doc": "validation/stats/ks_test.md",
      "cases": ["stat_ks_t3"],
      "tests": ["p2a-core::stats::ks::tests::test_validate_ks_t3_one_sample", "p2a-core::stats::ks::tests::test_validate_ks_t3_two_sample"],
