# Template for an R reference case. Copy into validation/r/cases/{{AREA_FILE}}.R (one file per area and
# package), fill the placeholders, then:
#   Rscript validation/r/run.R --write {{CASE_ID}} && Rscript validation/r/run.R --check {{CASE_ID}}
# Rules (validation/README.md, "Adding an R-pinned validation"): id ^[a-z0-9_]+$ with an area prefix;
# use the R function named as the method's reference; named() for named vectors, vec() for unnamed
# arrays; simulated data only through ctx$gen_dataset() after set.seed(); add stopifnot() for the
# property the case exists to exercise; data must have noise.
suppressPackageStartupMessages({ {{LIBRARY_CALLS}} })        # e.g. library(sandwich); library(plm)

case("{{CASE_ID}}", "{{AREA}}", "{{METHOD_NAME}}, {{DATASET_LABEL}}", function(ctx) {
  d <- ctx$dataset("datasets/{{DATASET}}.csv")              # committed data, path relative to validation/
  # Simulated instead:
  # set.seed({{SEED}})
  # d <- ctx$gen_dataset("{{GENERATED_NAME}}", data.frame({{COLUMNS}}))   # written, then read back
  fit <- {{R_FIT_CALL}}
  list(
    values = list(
      coef = named(coef(fit)),
      se = named(sqrt(diag(vcov(fit)))),
      {{EXTRA_VALUES}}                                     # every number p2a reports for this call
      n_obs = nobs(fit)
    ),
    reference = "{{R_REFERENCE}}",                         # e.g. "stats::lm; sandwich::vcovHC"
    call = "{{R_CALL_TEXT}}",
    packages = c({{PACKAGES}})                             # versions are recorded in the case JSON
  )
})

